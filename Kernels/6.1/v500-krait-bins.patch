 	snprintf(*pvs_name, sizeof("speedXX-pvsXX-vXX"), "speed%d-pvs%d-v%d",
 		 speed, pvs, pvs_ver);
 
--- a/drivers/clk/qcom/krait-cc.c
+++ b/drivers/clk/qcom/krait-cc.c
@@ -307,9 +307,13 @@
 	struct clk *l2_pri_mux_clk;
 
 	bool v500 = of_device_is_compatible(dev->of_node, "lg,v500-krait-cc");
+	unsigned long l2_rate;
 	int ret;
 
 	if (v500) {
+		ret = v500_l2_rate(dev, &l2_rate);
+		if (ret)
+			return dev_err_probe(dev, ret, "Krait speed bin\n");
 		ret = v500_prepare_krait(dev);
 		if (ret)
 			return dev_err_probe(dev, ret, "Krait supplies and clock parents\n");
@@ -396,8 +400,8 @@
 	}
 
 	if (v500) {
-		ret = clk_set_rate(l2_pri_mux_clk, 1188000000);
-		if (ret || clk_get_rate(l2_pri_mux_clk) != 1188000000)
+		ret = clk_set_rate(l2_pri_mux_clk, l2_rate);
+		if (ret || clk_get_rate(l2_pri_mux_clk) != l2_rate)
 			return dev_err_probe(dev, ret ?: -EIO, "L2 clock rate\n");
