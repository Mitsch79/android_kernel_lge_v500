--- a/drivers/cpufreq/qcom-cpufreq-nvmem.c
+++ b/drivers/cpufreq/qcom-cpufreq-nvmem.c
@@ -28,6 +28,10 @@
 #include <linux/slab.h>
 #include <linux/soc/qcom/smem.h>
 
+#ifdef CONFIG_ARM
+#include <asm/cputype.h>
+#endif
+
 #define MSM_ID_SMEM	137
 
 enum _msm_id {
@@ -238,6 +242,18 @@
 		goto len_error;
 	}
 
+#ifdef CONFIG_ARM
+	/* LG applies a minimum core voltage before adding the PVS boost. */
+	if (of_machine_is_compatible("lg,v500")) {
+		switch (read_cpuid_id()) {
+		case 0x511f04d0:
+		case 0x511f04d1:
+		case 0x510f06f0:
+			pvs_ver = 1;
+			break;
+		}
+	}
