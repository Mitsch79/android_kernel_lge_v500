 // push the scratch stack register on top of the stack
+/* The ARM EABI passes the aligned 64-bit second argument in r2:r3. */
+static u64 jit_atomic_add32(void *addr, u64 value)
+{
+	return (u32)atomic_fetch_add((int)value, (atomic_t *)addr);
+}
+
+static u64 jit_atomic_add64(void *addr, u64 value)
+{
+	return atomic64_fetch_add(value, (atomic64_t *)addr);
+}
+
+static void emit_atomic_add(const s8 dst[], const s8 src[], s16 off,
+			    bool wide, bool fetch, struct jit_ctx *ctx)
+{
+	const s8 *addr = bpf2a32[TMP_REG_1];
+	const s8 *value = bpf2a32[TMP_REG_2];
+	const s8 *r0 = bpf2a32[BPF_REG_0];
+	const s8 *r1 = bpf2a32[BPF_REG_1];
+	s8 base = arm_bpf_get_reg32(dst[1], addr[1], ctx);
+
+	/* Capture both operands before replacing any mapped BPF register. */
+	emit_mov_i(addr[0], (s32)off, ctx);
+	emit(ARM_ADD_R(addr[1], base, addr[0]), ctx);
+	emit_a32_mov_r64(true, value, src, ctx);
+	emit(ARM_PUSH(CALLER_MASK), ctx);
+	emit(ARM_MOV_R(ARM_R0, addr[1]), ctx);
+	emit_a32_mov_r64(true, r1, value, ctx);
+	emit_mov_i(ARM_IP, wide ? (u32)jit_atomic_add64 : (u32)jit_atomic_add32, ctx);
+	emit_blx_r(ARM_IP, ctx);
+	if (fetch)
+		emit_a32_mov_r64(true, value, r0, ctx);
+	emit(ARM_POP(CALLER_MASK), ctx);
+	if (fetch)
+		emit_a32_mov_r64(true, src, value, ctx);
+}
