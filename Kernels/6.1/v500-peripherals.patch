diff --git a/drivers/gpu/drm/panel/panel-lg-ld083wu1.c b/drivers/gpu/drm/panel/panel-lg-ld083wu1.c
new file mode 100644
index 000000000..a042fe669
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-lg-ld083wu1.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LG Display LD083WU1 on the LG V500.
+ * Timing and DCS commands from the V500 GPL kernel's
+ * mipi_lgit_video_wuxga_pt.c and board-awifi-display.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <video/mipi_display.h>
+
+static const struct drm_display_mode ld083wu1_mode = {
+	/* The APQ8064 DSI PLL can generate 155 MHz on its clock grid. */
+	.clock = 155000,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 44,
+	.hsync_end = 1200 + 44 + 32,
+	.htotal = 1200 + 44 + 32 + 60,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 5,
+	.vsync_end = 1920 + 5 + 5,
+	.vtotal = 1920 + 5 + 5 + 10,
+	.width_mm = 112,
+	.height_mm = 179,
+};
+
+static int ld083wu1_prepare(struct drm_panel *panel)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(panel->dev);
+	int ret;
+	u8 status;
+
+	/* Match the LG power-on delay after the host has enabled its rails. */
+	msleep(180);
+	mipi_dsi_dcs_write_seq(dsi, MIPI_DCS_SET_ADDRESS_MODE, 0x40);
+	ret = mipi_dsi_dcs_set_pixel_format(dsi, 0x70);
+	if (ret < 0)
+		return ret;
+	mipi_dsi_dcs_write_seq(dsi, 0xbb, 0xff);
+	mipi_dsi_dcs_write_seq(dsi, 0xb9, 0x00);
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0)
+		return ret;
+	msleep(120);
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0)
+		return ret;
+
+	ret = mipi_dsi_dcs_get_power_mode(dsi, &status);
+	if (ret < 0)
+		dev_warn(panel->dev, "LD083WU1 init sent, power-mode read failed: %d\n", ret);
+	else
+		dev_info(panel->dev, "LD083WU1 power mode after init: %#02x\n", status);
+
+	return 0;
+}
+
+static int ld083wu1_disable(struct drm_panel *panel)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(panel->dev);
+
+	int ret;
+
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0)
+		return ret;
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	if (ret < 0)
+		return ret;
+	msleep(120);
+
+	return 0;
+}
+
+static int ld083wu1_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &ld083wu1_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs ld083wu1_funcs = {
+	.prepare = ld083wu1_prepare,
+	.disable = ld083wu1_disable,
+	.get_modes = ld083wu1_get_modes,
+};
+
+static int ld083wu1_probe(struct mipi_dsi_device *dsi)
+{
+	struct drm_panel *panel;
+	int ret;
+
+	panel = devm_kzalloc(&dsi->dev, sizeof(*panel), GFP_KERNEL);
+	if (!panel)
+		return -ENOMEM;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	drm_panel_init(panel, &dsi->dev, &ld083wu1_funcs, DRM_MODE_CONNECTOR_DSI);
+	mipi_dsi_set_drvdata(dsi, panel);
+	drm_panel_add(panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		drm_panel_remove(panel);
+
+	return ret;
+}
+
+static void ld083wu1_remove(struct mipi_dsi_device *dsi)
+{
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(mipi_dsi_get_drvdata(dsi));
+}
+
+static const struct of_device_id ld083wu1_of_match[] = {
+	{ .compatible = "lg,ld083wu1" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ld083wu1_of_match);
+
+static struct mipi_dsi_driver ld083wu1_driver = {
+	.probe = ld083wu1_probe,
+	.remove = ld083wu1_remove,
+	.driver = {
+		.name = "panel-lg-ld083wu1",
+		.of_match_table = ld083wu1_of_match,
+	},
+};
+module_mipi_dsi_driver(ld083wu1_driver);
+
+MODULE_DESCRIPTION("LG Display LD083WU1 MIPI DSI panel");
+MODULE_LICENSE("GPL");
