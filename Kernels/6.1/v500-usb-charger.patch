+#include "v500-usb-charger.h"
+
+static void ci_v500_check_source(struct ci_hdrc *ci)
+{
+	u32 generation;
+	bool dedicated;
+
+	if (!of_property_read_bool(ci->dev->parent->of_node, "lge,v500-detect-charger"))
+		return;
+	spin_lock_irq(&ci->lock);
+	if (!ci->vbus_active || ci->v500_source_checked) {
+		spin_unlock_irq(&ci->lock);
+		return;
+	}
+	ci->v500_source_checked = true;
+	generation = ci->v500_attach_generation;
+	spin_unlock_irq(&ci->lock);
+
+	dedicated = v500_detect_dcp(ci);
+	spin_lock_irq(&ci->lock);
+	if (ci->vbus_active && ci->v500_attach_generation == generation) {
+		v500_usb_set_dedicated(dedicated);
+		dev_info(ci->dev, "V500 USB source: %s\n",
+			 dedicated ? "BC1.2 DCP" : "use gadget budget");
+	}
+	spin_unlock_irq(&ci->lock);
+}
+
